{
  "name": "cafe-backend",
  "version": "1.0.0",
  "description": "Express.js + TypeScript + Sequelize backend for the laptop shop, with a MySQL database",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/database/seed.ts",
    "seed:demo": "tsx src/database/seed-demo-products.ts",
    "test": "tsx --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "keywords": [
    "express",
    "mysql",
    "cafe",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.16.1",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
